# ==========================================
# Supabase 환경 변수 설정 (.env.local)
# Supabase 대시보드 > Project Settings > API 에서 확인 후 입력하세요.
# ==========================================

# 1. Supabase Project URL (예: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# 2. Supabase Anon Public Key (공개 익명 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 3. (선택사항) 관리자용 Service Role Key (서버 사이드 비번 리셋 등 관리용)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
